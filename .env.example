# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL — Supabase/Neon)
# Local dev (docker compose up -d): postgresql://stone:stone@localhost:5432/stone_mvp?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js
AUTH_SECRET=""

# Cloudinary (image upload). Without these keys, uploads are stored in public/uploads
# during local development only (never on Vercel/production).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (lead notification email)
RESEND_API_KEY=""
# Comma-separated recipients for new-lead emails.
LEAD_NOTIFY_EMAIL=""
# Sender, e.g. "Xuong da <lead@your-domain.vn>" (domain verified in Resend). Defaults to Resend's test sender.
LEAD_NOTIFY_FROM=""

# Telegram (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cloudflare Turnstile. For local dev you may use the official test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Production MUST use real keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""

# Seed admin (pnpm db:seed). Password >= 12 chars; only used when the admin does not exist yet.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
