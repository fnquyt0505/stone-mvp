# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL — Supabase/Neon)
# Local dev (docker compose up -d): postgresql://stone:stone@localhost:5432/stone_mvp?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js
AUTH_SECRET=""

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (lead notification email)
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL=""

# Telegram (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""

# Seed admin (pnpm db:seed). Password >= 12 chars; only used when the admin does not exist yet.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
