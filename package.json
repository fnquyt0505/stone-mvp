    "next": "15",
    "radix-ui": "^1.8.1",
    "react": "19",
    "react-dom": "19",
    "server-only": "^0.0.1",
    "yet-another-react-lightbox": "3",
    "zod": "3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "15",
    "eslint-config-prettier": "10",
    "prettier": "3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4",
    "tsx": "^4.23.15",
